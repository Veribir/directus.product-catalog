---
import type { Language } from "../lib/i18n";
import { assetUrl, loadAssetMap } from "../lib/assets";
import { fetchGlobals, fetchNavigation } from "../lib/api";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  language: Language;
  languages: Language[];
  preview?: boolean;
}

const { title, language, languages, preview = false } = Astro.props;

const [globals, mainNav, footerNav] = await Promise.all([
  fetchGlobals(),
  fetchNavigation("main"),
  fetchNavigation("footer"),
  loadAssetMap(),
]);

const pageTitle = title ?? globals.title ?? "Barkomas";
const faviconUrl = globals.favicon
  ? assetUrl(globals.favicon)
  : "/favicon.svg";
---

<html
  lang={language.code}
  dir={language.direction}
  style={globals.accent_color ? `--accent: ${globals.accent_color}` : ""}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {globals.description && <meta name="description" content={globals.description} />}
    <title>{pageTitle}</title>
  </head>
  <body class="m-0 font-sans antialiased bg-white text-slate-900">
    <Navbar {globals} navigation={mainNav} {language} {languages} currentPath={Astro.url.pathname} />
    <main class="pt-16">
      <slot />
    </main>
    <Footer {globals} navigation={footerNav} {language} />
    <script>
      const animatedEls = document.querySelectorAll('[data-animate]');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('animate-in'); observer.unobserve(e.target); } });
      }, { threshold: 0.08 });
      animatedEls.forEach(el => observer.observe(el));
    </script>
    {preview && (
      <script>
        // Keep internal navigation inside /preview/* (with the preview token)
        // so editors can browse draft content without leaving preview mode.
        const token = new URLSearchParams(window.location.search).get('token');
        if (token) {
          document.querySelectorAll('a[href^="/"]').forEach((a) => {
            const href = a.getAttribute('href');
            if (!href || href.startsWith('/preview/')) return;
            const url = new URL(href, window.location.origin);
            url.pathname = `/preview${url.pathname}`;
            url.searchParams.set('token', token);
            a.setAttribute('href', `${url.pathname}?${url.searchParams}${url.hash}`);
          });
        }
      </script>
    )}
  </body>
</html>
