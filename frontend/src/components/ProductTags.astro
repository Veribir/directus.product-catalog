---
import type { ProductTag } from "../lib/directus";
import { getTranslation } from "../lib/i18n";

interface Props {
  tags: { product_tags_id: ProductTag }[];
  locale: string;
}

const { tags, locale } = Astro.props;

if (tags.length === 0) return;
---

<div class="flex flex-wrap gap-2">
  {tags.map(({ product_tags_id: tag }) => {
    const tx = getTranslation(tag.translations, locale);
    return (
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors">
        {tx?.name ?? tag.slug}
      </span>
    );
  })}
</div>
