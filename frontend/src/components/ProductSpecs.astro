---
import type { ProductSpec, ProductVariant } from "../lib/directus";
import { getTranslation } from "../lib/i18n";

interface Props {
  specs: ProductSpec[];
  variants: ProductVariant[];
  locale: string;
  layout: "table" | "accordion" | "comparison";
}

const { specs, variants, locale, layout } = Astro.props;

const published = specs
  .filter((s) => s.status === "published")
  .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));

if (published.length === 0) return;

const groupMap = new Map<string, { label: string; icon: string | null; irdi: string | null; specs: typeof published }>();

for (const spec of published) {
  const groupId = spec.group?.id ?? "__ungrouped__";
  if (!groupMap.has(groupId)) {
    const groupTx = spec.group ? getTranslation(spec.group.translations, locale) : null;
    groupMap.set(groupId, {
      label: groupTx?.name ?? (spec.group ? spec.group.id : "Specifications"),
      icon: spec.group?.icon ?? null,
      irdi: spec.group?.irdi ?? null,
      specs: [],
    });
  }
  groupMap.get(groupId)!.specs.push(spec);
}

const groups = [...groupMap.values()];

function renderValue(spec: ProductSpec, locale: string): string {
  const tx = getTranslation(spec.translations, locale);
  if (!tx) return "";
  const raw = tx.value ?? "";
  if (spec.display_type === "boolean") {
    const lower = raw.toLowerCase();
    return lower === "true" || lower === "yes" || lower === "1" ? "✓ Yes" : "✗ No";
  }
  const unit = spec.unit?.symbol ?? "";
  return unit ? `${raw} ${unit}` : raw;
}

// Build value map from spec_variant_values nested under each spec
const valueMap: Record<string, Record<string, string>> = {};
for (const spec of published) {
  for (const sv of spec.spec_variant_values ?? []) {
    if (!valueMap[spec.id]) valueMap[spec.id] = {};
    valueMap[spec.id][sv.variant] = sv.value;
  }
}

function getComparisonValue(spec: ProductSpec, variant: ProductVariant, locale: string): string {
  const override = valueMap[spec.id]?.[variant.id];
  if (override !== undefined) {
    if (spec.display_type === "boolean") {
      const lower = override.toLowerCase();
      return lower === "true" || lower === "yes" || lower === "1" ? "✓ Yes" : "✗ No";
    }
    const unit = spec.unit?.symbol ?? "";
    return unit ? `${override} ${unit}` : override;
  }
  return renderValue(spec, locale);
}

const publishedVariants = variants.filter((v) => v.status === "published");
---

{/* ── TABLE layout ─────────────────────────────────────────────────────────── */}
{layout === "table" && (
  <div class="flex flex-col gap-8">
    {groups.map((group) => (
      <div>
        <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-700 mb-3" title={group.irdi ?? undefined}>
          {group.icon && (
            <span class="material-symbols-outlined text-base text-(--accent)" aria-hidden="true">
              {group.icon}
            </span>
          )}
          {group.label}
        </h3>
        <dl class="divide-y divide-slate-100 border border-slate-200 rounded-lg overflow-hidden">
          {group.specs.map((spec) => {
            const tx = getTranslation(spec.translations, locale);
            return (
              <div class="grid grid-cols-2 gap-4 px-4 py-2.5 even:bg-slate-50">
                <dt class="text-sm text-slate-500" title={spec.irdi ?? undefined}>{tx?.label}</dt>
                <dd class="text-sm font-medium text-slate-800">{renderValue(spec, locale)}</dd>
              </div>
            );
          })}
        </dl>
      </div>
    ))}
  </div>
)}

{/* ── ACCORDION layout ──────────────────────────────────────────────────────── */}
{layout === "accordion" && (
  <div class="flex flex-col divide-y divide-slate-100">
    {groups.map((group) => (
      <details class="group">
        <summary class="flex items-center justify-between gap-2 py-4 cursor-pointer select-none list-none hover:text-slate-900 transition-colors">
          <span class="flex items-center gap-2 text-base font-semibold text-slate-800 group-open:text-(--accent) transition-colors" title={group.irdi ?? undefined}>
            {group.icon && (
              <span class="material-symbols-outlined text-base text-(--accent)" aria-hidden="true">
                {group.icon}
              </span>
            )}
            {group.label}
          </span>
          <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <dl class="divide-y divide-slate-50 pb-4">
          {group.specs.map((spec) => {
            const tx = getTranslation(spec.translations, locale);
            return (
              <div class="grid grid-cols-2 gap-4 py-2.5">
                <dt class="text-sm text-slate-500" title={spec.irdi ?? undefined}>{tx?.label}</dt>
                <dd class="text-sm font-medium text-slate-800">{renderValue(spec, locale)}</dd>
              </div>
            );
          })}
        </dl>
      </details>
    ))}
  </div>
)}

{/* ── COMPARISON layout — accordion per group, variant columns in accent ───── */}
{layout === "comparison" && (
  <div class="flex flex-col divide-y divide-slate-100">
    {groups.map((group, gi) => (
      <details class="group" open={gi === 0 || undefined}>
        <summary class="flex items-center justify-between gap-2 py-4 cursor-pointer select-none list-none" title={group.irdi ?? undefined}>
          <span class="text-base font-semibold text-slate-800 group-open:text-(--accent) transition-colors">
            {group.label}
          </span>
          <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="pb-6 overflow-x-auto">
          {publishedVariants.length > 0 ? (
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr>
                  <th class="text-left py-2 pr-6 text-slate-400 font-medium w-40 border-b border-slate-100"></th>
                  {publishedVariants.map((variant) => {
                    const vtx = getTranslation(variant.translations, locale);
                    return (
                      <th class="text-left py-2 px-4 font-bold text-(--accent) border-b border-slate-100 whitespace-nowrap">
                        {vtx?.name ?? variant.sku ?? variant.id}
                      </th>
                    );
                  })}
                </tr>
              </thead>
              <tbody>
                {group.specs.map((spec) => {
                  const tx = getTranslation(spec.translations, locale);
                  return (
                    <tr class="border-b border-slate-50 hover:bg-slate-50 transition-colors">
                      <td class="py-2.5 pr-6 text-slate-500 font-medium text-sm" title={spec.irdi ?? undefined}>
                        {tx?.label}
                      </td>
                      {publishedVariants.map((variant) => {
                        const val = getComparisonValue(spec, variant, locale);
                        return (
                          <td class="py-2.5 px-4 text-slate-800 text-sm">
                            {val || <span class="text-slate-300">—</span>}
                          </td>
                        );
                      })}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          ) : (
            <dl class="divide-y divide-slate-50">
              {group.specs.map((spec) => {
                const tx = getTranslation(spec.translations, locale);
                return (
                  <div class="grid grid-cols-2 gap-4 py-2.5">
                    <dt class="text-sm text-slate-500" title={spec.irdi ?? undefined}>{tx?.label}</dt>
                    <dd class="text-sm font-medium text-slate-800">{renderValue(spec, locale)}</dd>
                  </div>
                );
              })}
            </dl>
          )}
        </div>
      </details>
    ))}
  </div>
)}
