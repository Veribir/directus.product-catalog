---
import type { ProductCategory, Product, PageBlock, ProductUrlStructure } from "../lib/directus";
import { assetUrl } from "../lib/assets";
import { getTranslation } from "../lib/i18n";
import { buildCategoryPaths, getProductFullPath } from "../lib/catalog";
import CategoryBreadcrumb from "./CategoryBreadcrumb.astro";
import PageBlocks from "./PageBlocks.astro";

interface Props {
  category: ProductCategory;
  products: Product[];
  allCategories: ProductCategory[];
  locale: string;
  categoryPath: string;
  productsPagePermalink: string;
  urlStructure: ProductUrlStructure;
}

const { category, products, allCategories, locale, categoryPath, productsPagePermalink, urlStructure } =
  Astro.props;

const tx = getTranslation(category.translations, locale);
const catPathMap = buildCategoryPaths(allCategories, locale);

const coverUrl = category.cover_image
  ? assetUrl(category.cover_image, "width=1920&height=800&fit=cover")
  : null;

const brandLogoUrl = category.brand?.logo
  ? assetUrl(category.brand.logo, "width=160&height=60&fit=contain")
  : null;

const children = allCategories.filter((c) => c.parent === category.id);

const visibleBlocks = (category.blocks ?? []).filter((b) => !b.hide_block);
const blocksAbove = visibleBlocks.filter((b) => b.position === "above");
const blocksBelow = visibleBlocks.filter((b) => b.position === "below");
---

<div>
  <div class="relative min-h-[60vh] md:min-h-[70vh] flex items-end bg-slate-900 overflow-hidden">
    {coverUrl && (
      <img src={coverUrl} alt={tx?.name ?? ""} class="absolute inset-0 w-full h-full object-cover" />
    )}
    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/40 to-black/10" />
    <div class="relative z-10 max-w-6xl mx-auto px-6 md:px-16 py-16 w-full">
      <CategoryBreadcrumb
        {categoryPath}
        {productsPagePermalink}
        {locale}
        {allCategories}
      />
      {tx?.tagline && (
        <p class="text-xs font-semibold tracking-widest uppercase mt-6 mb-3 text-(--accent)">
          {tx.tagline}
        </p>
      )}
      {tx?.name && (
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight text-white mb-4">
          {tx.name}
        </h1>
      )}
      {tx?.description && (
        <p class="text-base text-slate-300 leading-relaxed max-w-2xl mb-6">
          {tx.description}
        </p>
      )}
      <a
        href={`/${locale}${productsPagePermalink}`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-(--accent) text-white text-sm font-semibold hover:opacity-90 transition-opacity"
      >
        View All Products
      </a>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 md:px-16 py-12">
    {category.show_subcategories_bar && children.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-10">
        {children.map((child) => {
          const childTx = getTranslation(child.translations, locale);
          const childPath = catPathMap.get(child.id);
          const href = childPath ? `/${locale}${productsPagePermalink}/${childPath}` : null;
          return href ? (
            <a
              href={href}
              class="px-4 py-2 rounded-full border border-slate-200 bg-white hover:border-(--accent) hover:text-(--accent) transition-colors text-sm font-medium text-slate-700"
            >
              {childTx?.name ?? child.slug}
            </a>
          ) : null;
        })}
      </div>
    )}

    {blocksAbove.length > 0 && (
      <div class="mb-10">
        <PageBlocks
          blocks={blocksAbove as unknown as PageBlock[]}
          locale={locale}
          pagePermalink={productsPagePermalink}
        />
      </div>
    )}

    {products.length === 0 ? (
      <p class="text-slate-400 text-sm py-8 text-center">No products found in this category.</p>
    ) : (
      <ul class="list-none p-0 m-0 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => {
          const ptx = getTranslation(product.translations, locale);
          const imageUrl = product.image
            ? assetUrl(product.image, "width=500&height=667&fit=cover")
            : null;
          const fullPath = getProductFullPath(
            product.slug,
            product.category?.id ?? null,
            catPathMap,
            urlStructure,
          );
          const href = `/${locale}${productsPagePermalink}/${fullPath}`;

          return (
            <li class="relative flex flex-col overflow-hidden rounded-xl bg-slate-50 border border-slate-100 hover:shadow-lg transition-shadow group">
              {brandLogoUrl && (
                <div class="absolute top-3 right-3 z-10">
                  <img src={brandLogoUrl} alt="" class="h-7 w-auto opacity-90" loading="lazy" />
                </div>
              )}
              <a href={href} tabindex="-1" aria-hidden="true" class="block">
                {imageUrl ? (
                  <img
                    src={imageUrl}
                    alt={ptx?.name ?? ""}
                    class="w-full aspect-3/4 object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full aspect-3/4 flex items-center justify-center text-slate-300 bg-slate-100">
                    <span class="text-5xl">⚙️</span>
                  </div>
                )}
              </a>
              <div class="p-5 flex flex-col gap-2 flex-1">
                <h3 class="text-base font-bold leading-snug">
                  <a href={href} class="no-underline hover:text-(--accent) transition-colors text-slate-900">
                    {ptx?.name ?? product.slug}
                  </a>
                </h3>
                {tx?.model_list && (
                  <p class="text-xs text-slate-500">{tx.model_list}</p>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )}

    {blocksBelow.length > 0 && (
      <div class="mt-10">
        <PageBlocks
          blocks={blocksBelow as unknown as PageBlock[]}
          locale={locale}
          pagePermalink={productsPagePermalink}
        />
      </div>
    )}
  </div>
</div>
