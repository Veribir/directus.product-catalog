---
import type { ContentVersion } from "../lib/api";
import { getRuntimeEnv } from "../lib/env";

interface Props {
  versions: ContentVersion[];
  currentVersion: string | null;
}

const { versions, currentVersion } = Astro.props;

const extraVersions = versions.filter((v) => v.key !== "main");
const deployEnabled = !!(await getRuntimeEnv("DEPLOY_HOOK_URL"));
---

<div
  data-preview-toolbar
  class="fixed top-0 inset-x-0 z-60 h-10 overflow-hidden border-b border-slate-800 bg-slate-900 text-slate-200 transition-[height] duration-300"
  style="height: var(--preview-bar-h, 2.5rem)"
>
  <div class="max-w-6xl mx-auto px-6 h-10 flex items-center gap-3 text-sm">
    <span class="font-medium text-slate-400">Preview</span>
    <select
      data-version-select
      class="bg-slate-800 border border-slate-700 rounded-md px-2 py-1 text-sm text-slate-200 cursor-pointer"
    >
      <option value="" selected={!currentVersion}>Published</option>
      {extraVersions.map((v) => (
        <option value={v.key} selected={v.key === currentVersion}>
          {v.key === "draft" ? "Draft" : v.name ?? v.key}
        </option>
      ))}
    </select>

    {deployEnabled && (
      <button
        data-deploy-btn
        class="ml-auto flex items-center gap-1.5 rounded-md bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 px-3 py-1 text-sm font-medium text-white transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
        </svg>
        Deploy
      </button>
    )}
  </div>
</div>

<!-- Confirmation modal -->
{deployEnabled && (
  <div
    data-deploy-modal
    class="fixed inset-0 z-70 items-center justify-center bg-black/60 hidden"
    aria-modal="true"
    role="dialog"
  >
    <div class="bg-slate-900 border border-slate-700 rounded-xl shadow-2xl max-w-sm w-full mx-4 p-6 flex flex-col gap-4">
      <h2 class="text-base font-semibold text-white">Deploy to production?</h2>
      <p class="text-sm text-slate-400 leading-relaxed">
        This will trigger a full Cloudflare Pages build and deploy the latest published content to production.
        The deploy usually takes 1–2 minutes.
      </p>
      <div data-deploy-status class="hidden text-sm font-medium"></div>
      <div data-deploy-actions class="flex gap-3 justify-end">
        <button
          data-deploy-cancel
          class="rounded-md px-4 py-1.5 text-sm font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 transition-colors"
        >
          Cancel
        </button>
        <button
          data-deploy-confirm
          class="rounded-md px-4 py-1.5 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 transition-colors"
        >
          Deploy
        </button>
      </div>
    </div>
  </div>
)}

<script>
  // ── Version selector ──────────────────────────────────────────────────────
  const select = document.querySelector("[data-version-select]") as HTMLSelectElement | null;
  select?.addEventListener("change", () => {
    const url = new URL(window.location.href);
    if (select.value) {
      url.searchParams.set("version", select.value);
    } else {
      url.searchParams.delete("version");
    }
    window.location.href = url.toString();
  });

  // ── Hide-on-scroll ────────────────────────────────────────────────────────
  let lastScrollY = window.scrollY;
  function updateToolbar() {
    const scrollY = window.scrollY;
    if (scrollY > lastScrollY && scrollY > 60) {
      document.documentElement.style.setProperty("--preview-bar-h", "0px");
    } else {
      document.documentElement.style.setProperty("--preview-bar-h", "2.5rem");
    }
    lastScrollY = scrollY;
  }
  window.addEventListener("scroll", updateToolbar, { passive: true });

  // ── Deploy button + modal ─────────────────────────────────────────────────
  const deployBtn = document.querySelector("[data-deploy-btn]") as HTMLButtonElement | null;
  const modal = document.querySelector("[data-deploy-modal]") as HTMLElement | null;
  const cancelBtn = document.querySelector("[data-deploy-cancel]") as HTMLButtonElement | null;
  const confirmBtn = document.querySelector("[data-deploy-confirm]") as HTMLButtonElement | null;
  const statusEl = document.querySelector("[data-deploy-status]") as HTMLElement | null;
  const actionsEl = document.querySelector("[data-deploy-actions]") as HTMLElement | null;

  function openModal() {
    if (!modal) return;
    if (statusEl) { statusEl.className = "hidden text-sm font-medium"; statusEl.textContent = ""; }
    if (actionsEl) actionsEl.classList.remove("hidden");
    if (confirmBtn) { confirmBtn.disabled = false; confirmBtn.textContent = "Deploy"; }
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function closeModal() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
  }

  deployBtn?.addEventListener("click", openModal);
  cancelBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });

  confirmBtn?.addEventListener("click", async () => {
    if (!confirmBtn) return;
    confirmBtn.disabled = true;
    confirmBtn.textContent = "Deploying…";

    const token = new URLSearchParams(window.location.search).get("token") ?? "";
    try {
      const res = await fetch(`/api/deploy?token=${encodeURIComponent(token)}`, { method: "POST" });
      const data = await res.json() as { ok?: boolean; error?: string };
      if (res.ok && data.ok) {
        if (statusEl) {
          statusEl.textContent = "Deploy triggered. The site will be live in 1–2 minutes.";
          statusEl.className = "text-sm font-medium text-emerald-400";
          statusEl.classList.remove("hidden");
        }
        if (actionsEl) actionsEl.classList.add("hidden");
      } else {
        throw new Error(data.error ?? "Unknown error");
      }
    } catch (err) {
      if (statusEl) {
        statusEl.textContent = `Deploy failed: ${err instanceof Error ? err.message : err}`;
        statusEl.className = "text-sm font-medium text-red-400";
        statusEl.classList.remove("hidden");
      }
      if (confirmBtn) { confirmBtn.disabled = false; confirmBtn.textContent = "Retry"; }
    }
  });
</script>
