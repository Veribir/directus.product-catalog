---
import type { ProductBrand } from "../lib/directus";
import { assetUrl } from "../lib/assets";
import { getTranslation } from "../lib/i18n";

interface Props {
  brand: ProductBrand;
  locale: string;
}

const { brand, locale } = Astro.props;
const tx = getTranslation(brand.translations, locale);

const logoUrl = brand.logo
  ? assetUrl(brand.logo, "width=120&height=60&fit=contain")
  : null;
---

<div class="flex items-center gap-3">
  {logoUrl ? (
    <img src={logoUrl} alt={tx?.name ?? ""} class="h-8 w-auto object-contain" />
  ) : (
    <span class="text-sm font-semibold text-slate-700">{tx?.name}</span>
  )}
  {logoUrl && tx?.name && (
    <span class="text-sm text-slate-500">{tx.name}</span>
  )}
  {brand.website && (
    <a
      href={brand.website}
      target="_blank"
      rel="noopener"
      class="text-xs text-(--accent) hover:underline ml-auto"
    >
      Visit site ↗
    </a>
  )}
</div>
