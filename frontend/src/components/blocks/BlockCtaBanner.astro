---
import type { BlockCtaBanner } from "../../lib/directus";
import { getTranslation } from "../../lib/i18n";

interface Props {
  block: BlockCtaBanner;
  background: "light" | "dark";
  locale: string;
  pagePermalink: string;
}

const { block, locale } = Astro.props;
const tx = getTranslation(block.translations, locale);

const taglineParts = (tx?.tagline ?? "").split(" ");
const taglineLast = taglineParts.pop() ?? "";
const taglineRest = taglineParts.join(" ");
---

<section data-animate class="py-20 md:py-28 px-6 md:px-16 bg-white text-slate-900">
  <div class="max-w-3xl mx-auto text-center">
    {tx?.tagline && (
      <p class="text-xs font-semibold tracking-[0.2em] uppercase mb-6 text-slate-500">
        {taglineRest && <span>{taglineRest} </span>}
        <span class="text-(--accent)">{taglineLast}</span>
      </p>
    )}
    {tx?.headline && (
      <h2 class="text-3xl md:text-5xl font-bold leading-tight text-slate-900 mb-10">
        {tx.headline}
      </h2>
    )}
    <div class="flex flex-wrap justify-center gap-4">
      {tx?.primary_cta_label && block.primary_cta_url && (
        <a
          href={block.primary_cta_url}
          class="inline-flex items-center px-8 py-3.5 rounded-full bg-(--accent) text-white font-semibold text-sm hover:opacity-90 transition-opacity"
        >
          {tx.primary_cta_label}
        </a>
      )}
      {tx?.secondary_cta_label && block.secondary_cta_url && (
        <a
          href={block.secondary_cta_url}
          class="inline-flex items-center gap-1.5 px-4 py-3.5 text-slate-700 font-semibold text-sm hover:text-slate-900 transition-colors"
        >
          {tx.secondary_cta_label}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
        </a>
      )}
    </div>
  </div>
</section>
