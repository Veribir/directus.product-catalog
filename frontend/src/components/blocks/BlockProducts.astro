---
import type { BlockProducts } from "../../lib/directus";
import { DIRECTUS_URL } from "../../lib/directus";
import { fetchProducts, fetchAllCategories, fetchGlobals } from "../../lib/api";
import { buildCategoryPaths, getProductFullPath } from "../../lib/catalog";
import { getTranslation } from "../../lib/i18n";
import { formatPrice, isOnSale } from "../../lib/price";

interface Props {
  block: BlockProducts;
  background: "light" | "dark";
  locale: string;
  pagePermalink: string;
}

const { block, background, locale, pagePermalink } = Astro.props;
const tx = getTranslation(block.translations, locale);
const isDark = background === "dark";
const layout = block.layout ?? "grid_3";

const showPrice = block.show_price !== false; // default true
const showSku = block.show_sku === true;
const showCategoryLabel = block.show_category_label === true;

const gridClass = {
  grid_2: "sm:grid-cols-2",
  grid_3: "sm:grid-cols-2 lg:grid-cols-3",
  grid_4: "sm:grid-cols-2 lg:grid-cols-4",
  list: "",
}[layout];

const isList = layout === "list";

const [products, allCategories, globals] = await Promise.all([
  fetchProducts(block.limit ?? 6, block.category ?? undefined, block.sort_by),
  fetchAllCategories(),
  fetchGlobals(),
]);
const catPathMap = buildCategoryPaths(allCategories, locale);
const urlStructure = globals.product_url_structure ?? "category_prefixed";

// Pre-compute product row data to avoid < / <= in JSX context
const productRows = products.map((product) => {
  const ptx = getTranslation(product.translations, locale);
  const imageUrl = product.image
    ? `${DIRECTUS_URL}/assets/${product.image}?width=600&height=600&fit=cover`
    : null;
  const fullPath = getProductFullPath(product.slug, product.category?.id ?? null, catPathMap, urlStructure);
  const href = `/${locale}${pagePermalink}/${fullPath}`;
  const onSale = isOnSale(product.price, product.compare_at_price);
  const price = formatPrice(product.price, locale);
  const compareAt = formatPrice(product.compare_at_price, locale);
  const categoryName = product.category
    ? getTranslation(product.category.translations, locale)?.name ?? null
    : null;
  return { product, ptx, imageUrl, href, onSale, price, compareAt, categoryName };
});
---

<section
  class:list={[
    "px-6 py-20 md:px-16",
    isDark ? "bg-slate-800 text-slate-50" : "bg-slate-50 text-slate-900",
  ]}
>
  <div class="max-w-6xl mx-auto">

    {(tx?.tagline || tx?.headline) && (
      <div class="mb-12 text-center">
        {tx.tagline && (
          <p class="text-xs font-semibold tracking-widest uppercase mb-3 text-(--accent)">
            {tx.tagline}
          </p>
        )}
        {tx.headline && (
          <h2 class="text-3xl md:text-4xl font-bold leading-snug">{tx.headline}</h2>
        )}
      </div>
    )}

    <ul
      class:list={[
        "list-none p-0 m-0",
        isList ? "flex flex-col gap-6" : `grid gap-6 ${gridClass}`,
      ]}
    >
      {productRows.map(({ product, ptx, imageUrl, href, onSale, price, compareAt, categoryName }) =>
        isList ? (
          <li
            class:list={[
              "flex gap-5 rounded-xl border overflow-hidden transition-shadow hover:shadow-md",
              isDark ? "border-slate-700 bg-slate-900" : "border-slate-200 bg-white",
            ]}
          >
            {imageUrl && (
              <a href={href} class="shrink-0" tabindex="-1" aria-hidden="true">
                <img src={imageUrl} alt={ptx?.name ?? ""} class="w-36 h-36 object-cover" />
              </a>
            )}
            <div class="flex flex-col justify-center gap-2 py-4 pr-5">
              {showCategoryLabel && categoryName && (
                <p class="text-xs font-semibold tracking-widest uppercase text-(--accent)">
                  {categoryName}
                </p>
              )}
              <h3 class="text-base font-semibold leading-snug">
                <a
                  href={href}
                  class:list={["no-underline hover:underline", isDark ? "text-slate-50" : "text-slate-900"]}
                >
                  {ptx?.name ?? product.slug}
                </a>
              </h3>
              {ptx?.description && (
                <p class:list={["text-sm leading-relaxed line-clamp-2", isDark ? "text-slate-400" : "text-slate-500"]}>
                  {ptx.description}
                </p>
              )}
              {showSku && product.sku && (
                <p class:list={["text-xs font-mono", isDark ? "text-slate-500" : "text-slate-400"]}>
                  {product.sku}
                </p>
              )}
              {showPrice && (
                <div class="flex items-center gap-2 mt-1">
                  {product.rfq_enabled ? (
                    <span class="text-sm font-semibold text-(--accent)">Request a Quote</span>
                  ) : price ? (
                    <>
                      <span class="text-sm font-bold">{price}</span>
                      {onSale && (
                        <span class:list={["text-xs line-through", isDark ? "text-slate-500" : "text-slate-400"]}>
                          {compareAt}
                        </span>
                      )}
                      {onSale && (
                        <span class="text-xs font-semibold px-1.5 py-0.5 rounded bg-red-100 text-red-600">Sale</span>
                      )}
                    </>
                  ) : null}
                </div>
              )}
            </div>
          </li>
        ) : (
          <li
            class:list={[
              "flex flex-col rounded-xl border overflow-hidden transition-shadow hover:shadow-md",
              isDark ? "border-slate-700 bg-slate-900" : "border-slate-200 bg-white",
            ]}
          >
            <a href={href} tabindex="-1" aria-hidden="true" class="relative block">
              {imageUrl
                ? <img src={imageUrl} alt={ptx?.name ?? ""} class="w-full aspect-square object-cover" />
                : <div class:list={["w-full aspect-square flex items-center justify-center text-slate-300", isDark ? "bg-slate-800" : "bg-slate-100"]}>
                    <span class="text-4xl">📦</span>
                  </div>
              }
              {onSale && (
                <span class="absolute top-2 left-2 text-xs font-semibold px-2 py-0.5 rounded bg-red-500 text-white">
                  Sale
                </span>
              )}
            </a>
            <div class="flex flex-col flex-1 p-4 gap-2">
              {showCategoryLabel && categoryName && (
                <p class="text-xs font-semibold tracking-widest uppercase text-(--accent)">
                  {categoryName}
                </p>
              )}
              <h3 class="text-sm font-semibold leading-snug">
                <a
                  href={href}
                  class:list={["no-underline hover:underline", isDark ? "text-slate-50" : "text-slate-900"]}
                >
                  {ptx?.name ?? product.slug}
                </a>
              </h3>
              {showSku && product.sku && (
                <p class:list={["text-xs font-mono", isDark ? "text-slate-500" : "text-slate-400"]}>
                  {product.sku}
                </p>
              )}
              {showPrice && (
                <div class="flex items-center gap-2 mt-auto pt-2">
                  {product.rfq_enabled ? (
                    <span class="text-xs font-semibold text-(--accent)">Request a Quote</span>
                  ) : price ? (
                    <>
                      <span class="text-sm font-bold">{price}</span>
                      {onSale && (
                        <span class:list={["text-xs line-through", isDark ? "text-slate-500" : "text-slate-400"]}>
                          {compareAt}
                        </span>
                      )}
                    </>
                  ) : null}
                </div>
              )}
            </div>
          </li>
        )
      )}
    </ul>

    {block.cta_url && (
      <div class="mt-10 text-center">
        <a
          href={block.cta_url}
          class:list={[
            "inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-sm transition-colors",
            isDark
              ? "bg-white text-slate-900 hover:bg-slate-100"
              : "bg-(--accent) text-white hover:opacity-90",
          ]}
        >
          {tx?.cta_label ?? "View all"}
        </a>
      </div>
    )}

  </div>
</section>
