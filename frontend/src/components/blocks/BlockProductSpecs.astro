---
import type { BlockProductSpecs, ProductMedia, ProductVariant } from "../../lib/directus";
import { assetUrl } from "../../lib/assets";
import { getTranslation } from "../../lib/i18n";
import ProductSpecs from "../ProductSpecs.astro";

interface Props {
  block: BlockProductSpecs;
  variants: ProductVariant[];
  media: ProductMedia[];
  locale: string;
}

const { block, variants, media, locale } = Astro.props;

// A product's spec sheet is the union of all its variants' variant_spec_groups —
// there is no product-level spec list (see docs/product-catalog-schema-guide.md §6).
// Bail out early if no published variant has any spec data at all.
const hasAnySpecs = variants
  .filter((v) => v.status === "published")
  .some((v) => (v.variant_spec_groups ?? []).length > 0);
if (!hasAnySpecs) return;

const drawings = block.show_media
  ? media
      .filter((m) => m.status === "published" && m.purpose === "spec_drawing" && m.image)
      .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0))
  : [];

const mediaPosition = block.media_position ?? "left";
const leftDrawings =
  mediaPosition === "both"
    ? drawings.filter((d) => (d.position ?? "left") === "left")
    : mediaPosition === "left"
      ? drawings
      : [];
const rightDrawings =
  mediaPosition === "both"
    ? drawings.filter((d) => d.position === "right")
    : mediaPosition === "right"
      ? drawings
      : [];

const layout = block.layout ?? "table";
---

<div
  class:list={[
    "grid gap-12 items-start",
    leftDrawings.length > 0 && "md:grid-cols-[260px_1fr]",
    rightDrawings.length > 0 && "md:grid-cols-[1fr_260px]",
    leftDrawings.length > 0 && rightDrawings.length > 0 && "md:grid-cols-[260px_1fr_260px]",
  ]}
>
  {
    leftDrawings.length > 0 && (
      <div class="hidden md:flex flex-col gap-10 sticky top-24">
        {leftDrawings.map((d) => {
          const dtx = getTranslation(d.translations, locale);
          return (
            <figure class="m-0">
              <img
                src={assetUrl(d.image, "width=260&fit=contain&format=webp")}
                alt={dtx?.caption ?? ""}
                class="w-full object-contain opacity-70 mix-blend-multiply"
                loading="lazy"
              />
              {dtx?.caption && (
                <figcaption class="text-xs text-slate-400 mt-2 text-center">
                  {dtx.caption}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    )
  }

  <ProductSpecs {variants} {locale} {layout} specGroupFilter={block.spec_group} />

  {
    rightDrawings.length > 0 && (
      <div class="hidden md:flex flex-col gap-10 sticky top-24">
        {rightDrawings.map((d) => {
          const dtx = getTranslation(d.translations, locale);
          return (
            <figure class="m-0">
              <img
                src={assetUrl(d.image, "width=260&fit=contain&format=webp")}
                alt={dtx?.caption ?? ""}
                class="w-full object-contain opacity-70 mix-blend-multiply"
                loading="lazy"
              />
              {dtx?.caption && (
                <figcaption class="text-xs text-slate-400 mt-2 text-center">
                  {dtx.caption}
                </figcaption>
              )}
            </figure>
          );
        })}
      </div>
    )
  }
</div>
