---
import type { BlockNumberedList } from "../../lib/directus";
import { ASSETS_URL } from "../../lib/directus";
import { getTranslation } from "../../lib/i18n";

interface Props {
  block: BlockNumberedList;
  background: "light" | "dark";
  locale: string;
  pagePermalink: string;
}

const { block, background, locale } = Astro.props;
const tx = getTranslation(block.translations, locale);
const isDark = background === "dark";
const imageOnLeft = (block.layout ?? "image_left") === "image_left";

const items = (block.items ?? []).sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));

const imageUrl = block.image
  ? `${ASSETS_URL}/${block.image}?width=700&height=800&fit=cover`
  : null;
---

<section
  data-animate
  class:list={[
    "py-12 md:py-16 px-6 md:px-16",
    isDark ? "bg-zinc-950" : "bg-white",
  ]}
>
  <div class="max-w-6xl mx-auto">
    {isDark ? (
      /* Dark mode: everything inside a rounded dark card */
      <div class="rounded-3xl bg-zinc-900 overflow-hidden">
        <div class:list={["grid min-h-120", "md:grid-cols-2"]}>
          {imageOnLeft && (
            <div class="relative min-h-64 md:min-h-full bg-zinc-800">
              {imageUrl
                ? <img src={imageUrl} alt={tx?.image_title ?? ""} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                : <div class="absolute inset-0 bg-zinc-800" />
              }
              <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent" />
              {block.image_link && (
                <a href={block.image_link} class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center text-white hover:bg-white/25 transition-colors" aria-label="Learn more">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/><path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/></svg>
                </a>
              )}
              {tx?.image_title && (
                <p class="absolute bottom-5 left-6 text-white text-xl font-bold leading-snug">{tx.image_title}</p>
              )}
            </div>
          )}

          <div class="p-8 md:p-10 flex flex-col text-white">
            <div class="mb-6">
              {tx?.tagline && (
                <p class="text-xs font-semibold tracking-[0.2em] uppercase mb-2 text-(--accent)">{tx.tagline}</p>
              )}
              {tx?.headline && (
                <h2 class="text-xl md:text-2xl font-bold leading-snug text-white mb-2">{tx.headline}</h2>
              )}
              {tx?.description && (
                <p class="text-sm text-zinc-400 leading-relaxed">{tx.description}</p>
              )}
            </div>
            <div class="flex flex-col flex-1">
              {items.map((item, index) => {
                const itx = getTranslation(item.translations, locale);
                return (
                  <div class="flex items-start gap-4 py-4 border-b border-zinc-800 last:border-b-0">
                    <span class="text-sm font-bold text-zinc-600 shrink-0 w-6 pt-0.5">{String(index + 1).padStart(2, "0")}</span>
                    <span class="text-sm font-bold text-white leading-snug">{itx?.title}</span>
                  </div>
                );
              })}
            </div>
          </div>

          {!imageOnLeft && (
            <div class="relative min-h-64 md:min-h-full bg-zinc-800 order-first md:order-last">
              {imageUrl
                ? <img src={imageUrl} alt={tx?.image_title ?? ""} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                : <div class="absolute inset-0 bg-zinc-800" />
              }
              <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent" />
              {block.image_link && (
                <a href={block.image_link} class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center text-white hover:bg-white/25 transition-colors" aria-label="Learn more">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/><path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/></svg>
                </a>
              )}
              {tx?.image_title && (
                <p class="absolute bottom-5 left-6 text-white text-xl font-bold leading-snug">{tx.image_title}</p>
              )}
            </div>
          )}
        </div>
      </div>
    ) : (
      /* Light mode: white page, two columns side by side */
      <div class:list={["grid md:grid-cols-2 gap-12 items-start", !imageOnLeft && "md:[&>*:first-child]:order-2 md:[&>*:last-child]:order-1"]}>
        {/* List side */}
        <div class="flex flex-col">
          {tx?.tagline && (
            <p class="text-xs font-semibold tracking-[0.2em] uppercase mb-3 text-(--accent)">{tx.tagline}</p>
          )}
          {tx?.headline && (
            <h2 class="text-2xl md:text-3xl font-bold leading-snug text-slate-900 mb-3">{tx.headline}</h2>
          )}
          {tx?.description && (
            <p class="text-sm text-slate-500 leading-relaxed mb-6">{tx.description}</p>
          )}
          <div class="flex flex-col">
            {items.map((item, index) => {
              const itx = getTranslation(item.translations, locale);
              return (
                <div class="flex items-start gap-4 py-4 border-b border-slate-200 last:border-b-0">
                  <span class="text-sm font-bold text-slate-400 shrink-0 w-6 pt-0.5">{String(index + 1).padStart(2, "0")}</span>
                  <span class="text-sm font-bold text-slate-900 leading-snug">{itx?.title}</span>
                </div>
              );
            })}
          </div>
        </div>

        {/* Image card side */}
        <div class="relative rounded-3xl overflow-hidden bg-slate-200 min-h-80 md:min-h-120">
          {imageUrl
            ? <img src={imageUrl} alt={tx?.image_title ?? ""} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            : <div class="absolute inset-0 bg-slate-200" />
          }
          <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent" />
          {block.image_link && (
            <a href={block.image_link} class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center text-white hover:bg-white/25 transition-colors" aria-label="Learn more">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/><path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/></svg>
            </a>
          )}
          {tx?.image_title && (
            <p class="absolute bottom-5 left-6 text-white text-xl font-bold leading-snug">{tx.image_title}</p>
          )}
        </div>
      </div>
    )}
  </div>
</section>
