---
import type { Globals, Navigation } from "../lib/directus";
import { assetUrl } from "../lib/assets";
import type { Language } from "../lib/i18n";

interface Props {
  globals: Globals;
  navigation: Navigation | null;
  language: Language;
}

const { globals, navigation, language } = Astro.props;

const logoUrl = globals.logo_dark_mode
  ? assetUrl(globals.logo_dark_mode)
  : globals.logo
    ? assetUrl(globals.logo)
    : null;

const footerImageUrl = globals.footer_image
  ? assetUrl(globals.footer_image, "width=600&fit=contain")
  : null;

const siteTitle = globals.title ?? "Barkomas";
const currentYear = new Date().getFullYear();

function navHref(url: string | null | undefined): string {
  if (!url) return "#";
  if (url.startsWith("http") || url.startsWith("mailto:") || url.startsWith("tel:")) return url;
  return `/${language.code}${url}`;
}

const groups = (navigation?.items ?? [])
  .filter((i) => i.type === "group" && (i.children ?? []).length > 0)
  .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0));

const socialIcons: Record<string, string> = {
  facebook: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>`,
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>`,
  x: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>`,
  youtube: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 001.46 6.42 29 29 0 001 12a29 29 0 00.46 5.58 2.78 2.78 0 001.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.96A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon fill="white" points="9.75,15.02 15.5,12 9.75,8.98 9.75,15.02"/></svg>`,
};
---

<footer class="bg-zinc-900 text-slate-400 relative overflow-visible">
  {footerImageUrl && (
    <div class="absolute bottom-0 left-6 md:left-16 w-56 md:w-72 pointer-events-none select-none z-10" style="transform: translateY(-8px)">
      <img src={footerImageUrl} alt="" class="w-full object-contain object-bottom" loading="lazy" />
    </div>
  )}

  <div class="max-w-7xl mx-auto px-6 md:px-16">
    <div class="pt-12 pb-8">
      <a href={`/${language.code}`} class="inline-block mb-6">
        {logoUrl
          ? <img src={logoUrl} alt={siteTitle} class="h-8 w-auto" />
          : <span class="text-lg font-bold text-white">{siteTitle}</span>
        }
      </a>
      <hr class="border-zinc-700 mb-4" />
      {globals.email && (
        <a href={`mailto:${globals.email}`} class="text-sm text-slate-400 hover:text-white transition-colors">
          {globals.email}
        </a>
      )}
    </div>

    {groups.length > 0 && (
      <div class="flex justify-end gap-12 md:gap-20 py-10 border-t border-zinc-800">
        {groups.map((group) => (
          <div>
            <p class="text-xs font-bold tracking-widest uppercase text-white mb-5">{group.title}</p>
            <ul class="flex flex-col gap-3">
              {(group.children ?? [])
                .sort((a, b) => (a.sort ?? 0) - (b.sort ?? 0))
                .map((child) => (
                  <li>
                    <a href={navHref(child.url)} class="text-sm text-zinc-500 hover:text-white transition-colors">
                      {child.title}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))}
      </div>
    )}

    <div class="py-8 border-t border-zinc-800 flex items-end justify-between gap-4">
      <div>
        {logoUrl
          ? <img src={logoUrl} alt={siteTitle} class="h-10 w-auto opacity-70" />
          : <span class="text-xl font-bold text-white/70">{siteTitle}</span>
        }
      </div>
      <div class="text-right">
        <p class="text-sm font-bold tracking-widest uppercase text-white">EXPLORING DEEPER</p>
        <p class="text-xs text-zinc-600 mt-0.5">SINCE 1987</p>
      </div>
    </div>

    <div class="py-5 border-t border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="text-xs text-zinc-600">© {currentYear} {siteTitle}. All rights reserved.</span>
      {(globals.social_links ?? []).length > 0 && (
        <div class="flex items-center gap-3">
          {(globals.social_links ?? []).map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-500 hover:text-white transition-colors"
              aria-label={link.service}
              set:html={socialIcons[link.service] ?? `<span class="text-xs font-bold uppercase">${link.service.slice(0,2)}</span>`}
            />
          ))}
        </div>
      )}
    </div>
  </div>
</footer>
