---
import type { Globals, Page } from "../lib/directus";
import { DIRECTUS_URL } from "../lib/directus";
import type { Language } from "../lib/i18n";

interface Props {
  globals: Globals;
  navPages: Pick<Page, "permalink" | "title">[];
  language: Language;
  languages: Language[];
  currentPath: string;
}

const { globals, navPages, language, languages, currentPath } = Astro.props;

const logoUrl = globals.logo ? `${DIRECTUS_URL}/assets/${globals.logo}` : null;
const siteTitle = globals.title ?? "Barkomas";

function pageHref(permalink: string) {
  return permalink === "/" ? `/${language.code}` : `/${language.code}${permalink}`;
}

function localeHref(locale: string) {
  // Swap the locale segment in the current path: /en-US/about → /fr-FR/about
  return currentPath.replace(`/${language.code}`, `/${locale}`) || `/${locale}`;
}
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-slate-200">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center gap-8">
    <!-- Logo / site title -->
    <a href={`/${language.code}`} class="flex items-center gap-2.5 shrink-0 no-underline">
      {
        logoUrl ? (
          <img src={logoUrl} alt={siteTitle} class="h-8 w-auto" />
        ) : (
          <span class="text-lg font-bold text-slate-900">{siteTitle}</span>
        )
      }
    </a>

    <!-- Nav links -->
    <nav class="flex items-center gap-1 flex-1" aria-label="Main navigation">
      {
        navPages.map((page) => {
          const href = pageHref(page.permalink);
          const isActive = currentPath === href;
          return (
            <a
              href={href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "px-3 py-1.5 rounded-md text-sm font-medium no-underline transition-colors",
                isActive
                  ? "bg-slate-100 text-slate-900"
                  : "text-slate-600 hover:text-slate-900 hover:bg-slate-50",
              ]}
            >
              {page.title}
            </a>
          );
        })
      }
    </nav>

    <!-- Locale dropdown -->
    <div class="shrink-0">
      <select
        id="locale-switcher"
        aria-label="Switch language"
        class="text-sm font-medium text-slate-700 bg-transparent border border-slate-200 rounded-md px-2 py-1.5 cursor-pointer hover:border-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-300"
      >
        {
          languages.map((lang) => (
            <option value={localeHref(lang.code)} selected={lang.code === language.code}>
              {lang.name}
            </option>
          ))
        }
      </select>
    </div>
  </div>
</header>

<script>
  const select = document.getElementById("locale-switcher") as HTMLSelectElement | null;
  select?.addEventListener("change", () => {
    if (select.value) window.location.href = select.value;
  });
</script>
