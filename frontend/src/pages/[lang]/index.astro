---
import { getLanguages, getDefaultLanguage, type Language } from "../../lib/i18n";
import HomeContent from "../../components/HomeContent.astro";

export async function getStaticPaths() {
  const languages = await getLanguages();
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { language: lang, languages },
  }));
}

const { language, languages } = Astro.props as { language: Language; languages: Language[] };

// The default locale's homepage is also served unprefixed at "/" — point both
// at the same canonical URL so search engines don't see them as duplicates.
const defaultLanguage = getDefaultLanguage(languages);
const canonicalPath = language.code === defaultLanguage.code ? "/" : undefined;
---

<HomeContent {language} {languages} {canonicalPath} />
